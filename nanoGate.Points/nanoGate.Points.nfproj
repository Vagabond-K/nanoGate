<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <NanoFrameworkProjectSystemPath Condition="'$(NanoFrameworkProjectSystemPath)' == ''">$(MSBuildExtensionsPath)\nanoFramework\v1.0\</NanoFrameworkProjectSystemPath>
  </PropertyGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.Default.props" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.Default.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectTypeGuids>{11A8DD76-328B-46DF-9F39-F559912D0360};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{7C3F2A18-9B4D-4E5F-8A6C-2D9E1F4B7C83}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>nanoGate.Points</RootNamespace>
    <AssemblyName>nanoGate.Points</AssemblyName>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <LangVersion>7.3</LangVersion>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <PackagesPath>$(MSBuildThisFileDirectory)..\packages\</PackagesPath>
  </PropertyGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.props" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.props')" />
  <ItemGroup>
    <ProjectReference Include="..\nanoGate.Core\nanoGate.Core.nfproj">
      <Name>nanoGate.Core</Name>
      <Project>{5B1E9D24-3F67-4A8C-9D0B-64C8E217F3A9}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="PointMapping.cs" />
    <Compile Include="PointMappingStore.cs" />
    <Compile Include="Controllers\PointsController.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(PackagesPath)nanoFramework.CoreLibrary.1.17.11\lib\mscorlib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="nanoFramework.System.Text">
      <HintPath>$(PackagesPath)nanoFramework.System.Text.1.3.42\lib\nanoFramework.System.Text.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.FileSystem">
      <HintPath>$(PackagesPath)nanoFramework.System.IO.FileSystem.1.1.96\lib\System.IO.FileSystem.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Streams">
      <HintPath>$(PackagesPath)nanoFramework.System.IO.Streams.1.1.96\lib\System.IO.Streams.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net">
      <HintPath>$(PackagesPath)nanoFramework.System.Net.1.11.66\lib\System.Net.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(PackagesPath)nanoFramework.System.Net.Http.Server.1.5.214\lib\System.Net.Http.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="nanoFramework.WebServer">
      <HintPath>$(PackagesPath)nanoFramework.WebServer.1.2.162\lib\nanoFramework.WebServer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VagabondK.nF.Web">
      <HintPath>$(PackagesPath)VagabondK.nF.Web.0.1.0-preview.7\lib\VagabondK.nF.Web.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets')" />
  <!--
    포인트 매핑 도메인 어셈블리: 표 문법·구문 해석·저장·/api/points 컨트롤러.
    포인트 매핑을 사용하는 게이트웨이(DNP3, MQTT)만 ProjectReference로 참조하고,
    Serial↔TCP 게이트웨이는 참조하지 않아 코드도 라우트도 배포되지 않습니다.
  -->
</Project>
